@using Billing_software.Models;

@{
    List<Tblcustomer> lst = (List<Tblcustomer>)ViewData["customerdata"];
}

<table class="table table-bordered table-hover table-striped">

    <thead>
        <tr>
            <th>Customer ID</th>
            <th>Customer Name</th>
            <th>Mobile No</th>
            <th>City</th>
            <th>Action</th>

        </tr>
    </thead>
    <tbody>

        @foreach (var d in lst)
        {
            <tr>
                <td>@d.CustomerId</td>
                <td>@d.CustomerName</td>
                <td>@d.MobileNo</td>
                <td>@d.City</td>
                <td>
                    <a href="/Customer/Edit/@d.CustomerId" class="btn btn-warning">Edit</a>&nbsp;
                    <a href="/Customer/Delete/@d.CustomerId" class="btn btn-danger">Delete</a>

                </td>
            </tr>
        }

    </tbody>

</table>